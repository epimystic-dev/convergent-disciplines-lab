{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/epimystic-dev/convergent-disciplines-lab/threads/schemas/dialogue.schema.json",
  "title": "Dialogue",
  "description": "Structured turns for the points-of-defeat linter (D2, D3).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "asks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "addresses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "thesis": {
            "type": [
              "string",
              "null"
            ]
          },
          "thesis_revised": {
            "type": "boolean"
          },
          "commitments_added": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "commitments_withdrawn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "critique": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "n",
          "speaker",
          "text"
        ]
      }
    }
  },
  "required": [
    "id",
    "turns"
  ],
  "additionalProperties": false
}
