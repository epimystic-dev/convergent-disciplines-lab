{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/epimystic-dev/convergent-disciplines-lab/threads/schemas/convergence.schema.json",
  "title": "Convergence assessment",
  "description": "A claimed convergence across traditions with its routes, upstream links and declared grade (orthogonality-as-evidence).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "shape": {
      "type": "string",
      "minLength": 1
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tradition": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "validation": {
            "type": "string",
            "minLength": 1
          },
          "social_conditions": {
            "type": "string",
            "minLength": 1
          },
          "cosmology": {
            "type": "string",
            "minLength": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "distinct_content": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "tradition",
          "method",
          "distinct_content"
        ]
      }
    },
    "upstream_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "between": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "kind": {
            "enum": [
              "shared_translation_vocabulary",
              "shared_lineage",
              "comparative_project",
              "active_dialogue",
              "shared_forum",
              "synthesist_frame",
              "citation_artefact",
              "direct_influence"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "between",
          "kind"
        ]
      }
    },
    "disagreements_preserved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "declared_grade": {
      "enum": [
        "strong",
        "partial",
        "withdrawn",
        "author_thesis"
      ]
    },
    "selection_is_choice": {
      "type": "boolean"
    },
    "falsifier": {
      "type": "string",
      "minLength": 1
    },
    "independent_audit": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "shape",
    "routes",
    "declared_grade",
    "falsifier"
  ],
  "additionalProperties": false
}
