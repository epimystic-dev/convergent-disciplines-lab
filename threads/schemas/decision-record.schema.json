{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/epimystic-dev/convergent-disciplines-lab/threads/schemas/decision-record.schema.json",
  "title": "Decision record",
  "description": "A consequential estimate or decision with the debiasing structure the lessons require (S8).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "stakes": {
      "enum": [
        "low",
        "high"
      ]
    },
    "decided_by": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "level": {
      "enum": [
        "practical",
        "foundational"
      ]
    },
    "estimate": {
      "type": "string",
      "minLength": 1
    },
    "reference_class": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "base_rate": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "class",
        "base_rate"
      ]
    },
    "premortem": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "alternatives_discarded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "adversarial_check": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "finding": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "by",
        "finding"
      ]
    },
    "diversification": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "revisit_after": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  },
  "required": [
    "id",
    "decision",
    "stakes",
    "decided_by"
  ],
  "additionalProperties": false
}
