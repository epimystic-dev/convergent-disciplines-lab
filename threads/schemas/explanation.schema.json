{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/epimystic-dev/convergent-disciplines-lab/threads/schemas/explanation.schema.json",
  "title": "Explanation",
  "description": "An explanation with what constrains each detail and the counterfactuals it commits to (R2, hard to vary).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "conclusion": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "constrained_by": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "detail",
          "constrained_by"
        ]
      }
    },
    "counterfactuals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "if": {
            "type": "string",
            "minLength": 1
          },
          "then": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "if",
          "then"
        ]
      }
    }
  },
  "required": [
    "id",
    "conclusion",
    "details",
    "counterfactuals"
  ],
  "additionalProperties": false
}
