{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/epimystic-dev/convergent-disciplines-lab/threads/schemas/consensus.schema.json",
  "title": "Multi-agent consensus",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1
    },
    "votes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string",
            "minLength": 1
          },
          "lineage": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "agent",
          "lineage",
          "answer"
        ]
      }
    },
    "diversity_attestation": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "by"
      ]
    }
  },
  "required": [
    "question",
    "votes"
  ],
  "additionalProperties": false
}
