{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/epimystic-dev/convergent-disciplines-lab/threads/schemas/claim.schema.json",
  "title": "Claim",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "standing": {
      "enum": [
        "settled",
        "established",
        "contested",
        "limit",
        "bridge",
        "method"
      ]
    },
    "basis": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "observation",
            "inference",
            "testimony",
            "recall",
            "convergence",
            "framework",
            "author_thesis",
            "method"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "level": {
      "enum": [
        "practical",
        "foundational"
      ]
    },
    "rung": {
      "enum": [
        1,
        2,
        3,
        null
      ]
    },
    "causal_assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "structural_model": {
      "type": "string",
      "minLength": 1
    },
    "defeaters": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "identifiable": {
      "type": "boolean"
    },
    "configuration": {
      "type": "string",
      "minLength": 1
    },
    "behaviour_level": {
      "enum": [
        "weights",
        "training_data",
        "prompt_context",
        "interface",
        "institution"
      ]
    },
    "assumptions_other_levels": {
      "type": "string",
      "minLength": 1
    },
    "numeric": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "primary": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "ref"
        ]
      }
    },
    "forecast": {
      "type": "object",
      "properties": {
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "window": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ]
        },
        "status": {
          "enum": [
            "not_falsified",
            "confirmed",
            "falsified"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "framework",
        "scope",
        "window",
        "status"
      ]
    },
    "risk": {
      "type": "object",
      "properties": {
        "frame": {
          "type": "string",
          "minLength": 1
        },
        "record": {
          "type": "string",
          "minLength": 1
        },
        "probability": {
          "type": "string",
          "minLength": 1
        },
        "probability_source": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "frame",
        "record",
        "probability"
      ]
    },
    "disagreement_ref": {
      "type": "string",
      "minLength": 1
    },
    "self_report": {
      "type": "boolean"
    },
    "verified_by": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "text",
    "standing"
  ],
  "description": "One claim with its standing, basis and, where relevant, its causal rung."
}
